# =============================================================================
# LearnHub — environment variables (Supabase + Next.js)
# =============================================================================
#
# Setup:
#   1. cp .env.example .env.local
#   2. Create a project at https://supabase.com/dashboard
#   3. Fill Supabase + AI sections below
#   4. supabase link && supabase db push
#   5. pnpm supabase:seed
#   6. pnpm dev
#
# Security:
#   - OK in .env.local with NEXT_PUBLIC_* : Supabase URL + anon key (RLS protects data)
#   - NEVER expose: SUPABASE_SERVICE_ROLE_KEY, GROQ/Gemini/OpenRouter keys, DATABASE_URL
#   - Do not commit .env.local
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LearnHub


# -----------------------------------------------------------------------------
# Supabase — Auth, Postgres, Storage (required)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy anon JWT (Dashboard → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Or Supabase publishable key (same slot as anon for the browser client)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: seed script, admin tasks, bypasses RLS. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional alias for scripts/supabase-seed.mjs
SUPABASE_URL=

# Postgres for pnpm db:migrate, API routes, and seeds.
# Dashboard → Project Settings → Database → Connection string → URI (Session pooler).
# Copy the host exactly (e.g. aws-1-eu-central-1.pooler.supabase.com — not a literal [region]).
# On Windows, avoid db.[ref].supabase.co (often IPv6-only); use the pooler URI instead.
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-YOUR-REGION.pooler.supabase.com:5432/postgres
# Optional: MIGRATION_DATABASE_URL=... (session/direct) if DATABASE_URL uses transaction pooler :6543


# -----------------------------------------------------------------------------
# Demo accounts (pnpm supabase:seed)
# Creates email-confirmed: student@ / lecturer@ / admin@ / superadmin@learnhub.demo
# -----------------------------------------------------------------------------

DEMO_ACCOUNT_PASSWORD=LearnHubDemo2026!


# -----------------------------------------------------------------------------
# AI assistant & Test Yourself (server-only — Next.js API / Edge routes)
# Pick one provider block. Keys must NOT be prefixed with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

AI_PROVIDER=groq
AI_LIFETIME_MESSAGE_LIMIT=10

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# AI_MODEL=llama-3.3-70b-versatile

# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free


# -----------------------------------------------------------------------------
# Email (optional — password reset, notifications)
# -----------------------------------------------------------------------------

# RESEND_API_KEY=
# EMAIL_FROM=LearnHub <noreply@yourdomain.com>


# -----------------------------------------------------------------------------
# Vercel / production (required for login → /api/workspace after Supabase Auth)
# Project → Settings → Environment Variables (Production + Preview)
# -----------------------------------------------------------------------------

# NEXT_PUBLIC_APP_URL=https://learnhub-gh.vercel.app
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY=...  (for pnpm supabase:seed against production, server-only)
#
# After first deploy:
#   1. pnpm db:migrate   (with DATABASE_URL in .env.local targeting prod)
#   2. pnpm supabase:seed (creates *@learnhub.demo users; set DEMO_ACCOUNT_PASSWORD)
#   3. Open https://YOUR_APP.vercel.app/api/health — all checks should be "ok"


# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------

# PLAYWRIGHT_BASE_URL=http://localhost:3000


# =============================================================================
# Legacy — not used on the Supabase stack (remove from .env.local if present)
# =============================================================================
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=
# CONVEX_DEPLOYMENT=
# ALLOW_DEMO_SEED=          (was Convex seed flag — use pnpm supabase:seed instead)
# BETTER_AUTH_SECRET=       (only if you still run Better Auth + DATABASE_URL)
# BLOB_READ_WRITE_TOKEN=    (only if you still use Vercel Blob uploads)
