{
  "name": "learnhub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
   "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:audit": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test e2e/access-audit.spec.ts",
    "test:lighthouse": "node scripts/lighthouse-audit.mjs",
    "test:e2e:install": "playwright install chromium",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.mjs",
    "supabase:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/supabase-seed.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.16.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.7",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.7.3"
  }
}
